# Copy to .env and fill in. Both domains must point (DNS A record) to this VPS.
API_DOMAIN=share.exemplo.com
LIVEKIT_DOMAIN=livekit.exemplo.com

# Secrets: generate each with  openssl rand -base64 48
APP_JWT_SECRET=
LIVEKIT_API_SECRET=

# Name of the LiveKit API key (any string).
LIVEKIT_API_KEY=sharescreen
