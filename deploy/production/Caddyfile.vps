sync.devluizfernando.com.br {
	reverse_proxy 127.0.0.1:8080
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

gym.devluizfernando.com.br {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		root * /var/www/gym
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
	@nocache path /sw.js /registerSW.js /index.html /manifest.webmanifest
	header @nocache Cache-Control "no-store"
}

share.devluizfernando.com.br {
	reverse_proxy 127.0.0.1:8081
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

livekit.devluizfernando.com.br {
	reverse_proxy 127.0.0.1:7880
}
