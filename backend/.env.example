# Address the HTTP API listens on.
APP_ADDR=:8080
# SQLite database file (created on first run).
APP_DB_PATH=./data/app.db
# HMAC secret for access tokens. At least 32 bytes. Generate with: openssl rand -base64 48
APP_JWT_SECRET=
# Token lifetimes (Go duration syntax).
APP_ACCESS_TTL=15m
APP_REFRESH_TTL=720h
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
APP_TRUST_PROXY=false
# How long a private (temporary) room may stay empty before it is deleted.
APP_TEMP_ROOM_GRACE=5m
